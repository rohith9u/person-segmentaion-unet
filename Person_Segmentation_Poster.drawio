<mxCell id="c107" value="REFERENCES  |  Penn–Fudan Pedestrian Dataset: cis.upenn.edu/~jshi/ped_html/  •  Ronneberger et al., U-Net: Convolutional Networks for Biomedical Image Segmentation, MICCAI 2015." style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=center;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Aptos;fontSize=10;fontColor=#FFFFFF;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="36.5" y="666.2" width="1206.7" height="22.1" as="geometry"/></mxCell>
