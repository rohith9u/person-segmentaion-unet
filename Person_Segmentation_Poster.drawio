<mxCell id="c95" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2A69A6;strokeColor=#2A69A6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="908.2" y="347.5" width="6.2" height="117.1" as="geometry"/></mxCell>
<mxCell id="c96" value="&lt;b&gt;WHAT CHANGED?&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Aptos;fontSize=14;fontColor=#2A69A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920.6" y="353.3" width="326.4" height="22.1" as="geometry"/></mxCell>
<mxCell id="c97" value="• Test IoU increased by 0.0609 (about 10.1% relative).&lt;br&gt;• Test Dice increased by 0.0456.&lt;br&gt;• Test BCE loss decreased by about 28.3%.&lt;br&gt;• Precision improved (0.7016 → 0.7897); recall was similar (0.8119 → 0.8071)." style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Aptos;fontSize=11;fontColor=#26313D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="920.6" y="380.2" width="326.4" height="79.7" as="geometry"/></mxCell>
<mxCell id="c98" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E7F4EF;strokeColor=#BECDDA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="908.2" y="474.2" width="347.5" height="103.7" as="geometry"/></mxCell>
<mxCell id="c99" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#188489;strokeColor=#188489;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="908.2" y="474.2" width="6.2" height="103.7" as="geometry"/></mxCell>
<mxCell id="c100" value="&lt;b&gt;CONCLUSION&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Aptos;fontSize=14;fontColor=#188489;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920.6" y="480.0" width="326.4" height="22.1" as="geometry"/></mxCell>
<mxCell id="c101" value="On this held-out Penn–Fudan test split, augmentation improved overall mask overlap and reduced prediction loss. The augmented U-Net achieved 0.6644 IoU and 0.7983 Dice." style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Aptos;fontSize=11;fontColor=#26313D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="920.6" y="506.9" width="326.4" height="66.2" as="geometry"/></mxCell>
<mxCell id="c102" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BECDDA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="908.2" y="587.5" width="347.5" height="49.9" as="geometry"/></mxCell>
<mxCell id="c103" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DEA441;strokeColor=#DEA441;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="908.2" y="587.5" width="6.2" height="49.9" as="geometry"/></mxCell>
<mxCell id="c104" value="&lt;b&gt;SCOPE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Aptos;fontSize=14;fontColor=#DEA441;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920.6" y="593.3" width="326.4" height="22.1" as="geometry"/></mxCell>
<mxCell id="c105" value="Results are specific to this dataset split; testing on more diverse datasets is future work." style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Aptos;fontSize=10;fontColor=#26313D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="920.6" y="620.2" width="326.4" height="12.5" as="geometry"/></mxCell>
