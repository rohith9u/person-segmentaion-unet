<mxCell id="c86" value="0.2142" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EBF3FA;strokeColor=#BECDDA;align=center;verticalAlign=middle;spacingLeft=6;fontFamily=Aptos;fontSize=11;fontColor=#26313D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1046.3999999999999" y="236.7" width="88.3" height="32.2" as="geometry"/></mxCell>
