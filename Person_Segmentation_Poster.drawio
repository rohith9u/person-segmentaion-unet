<mxCell id="c5" value="&lt;b&gt;PERSON SEGMENTATION USING U-NET&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=center;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Aptos;fontSize=31;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="33.6" y="9.6" width="1212.5" height="38.4" as="geometry"/></mxCell>
<mxCell id="c6" value="A comparison of standard training and data-augmented training on the Penn–Fudan Pedestrian Dataset" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=center;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Aptos;fontSize=15;fontColor=#DCE8F4;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="43.2" y="50.9" width="1193.3" height="21.1" as="geometry"/></mxCell>
