<mxCell id="c88" value="Dice / F1 ↑" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#BECDDA;align=left;verticalAlign=middle;spacingLeft=6;fontFamily=Aptos;fontSize=11;fontColor=#26313D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="917.8" y="268.9" width="128.6" height="32.2" as="geometry"/></mxCell>
