<mxCell id="c90" value="0.7983" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#BECDDA;align=center;verticalAlign=middle;spacingLeft=6;fontFamily=Aptos;fontSize=11;fontColor=#26313D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1134.6999999999998" y="268.9" width="105.6" height="32.2" as="geometry"/></mxCell>
<mxCell id="c91" value="IoU ↑" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EBF3FA;strokeColor=#BECDDA;align=left;verticalAlign=middle;spacingLeft=6;fontFamily=Aptos;fontSize=11;fontColor=#26313D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="917.8" y="301.09999999999997" width="128.6" height="32.2" as="geometry"/></mxCell>
<mxCell id="c92" value="0.6035" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EBF3FA;strokeColor=#BECDDA;align=center;verticalAlign=middle;spacingLeft=6;fontFamily=Aptos;fontSize=11;fontColor=#26313D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1046.3999999999999" y="301.09999999999997" width="88.3" height="32.2" as="geometry"/></mxCell>
<mxCell id="c93" value="0.6644" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EBF3FA;strokeColor=#BECDDA;align=center;verticalAlign=middle;spacingLeft=6;fontFamily=Aptos;fontSize=11;fontColor=#26313D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1134.6999999999998" y="301.09999999999997" width="105.6" height="32.2" as="geometry"/></mxCell>
