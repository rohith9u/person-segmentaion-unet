<mxCell id="c72" value="Encoder: repeated convolution + downsampling captures context.  Decoder: upsampling restores resolution.  Skip connections pass fine spatial details from encoder to decoder." style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=center;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Aptos;fontSize=10;fontColor=#586775;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="399.4" y="471.4" width="474.2" height="25.9" as="geometry"/></mxCell>
<mxCell id="c73" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BECDDA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="382.1" y="520.3" width="508.8" height="117.1" as="geometry"/></mxCell>
<mxCell id="c74" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#188489;strokeColor=#188489;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="382.1" y="520.3" width="6.2" height="117.1" as="geometry"/></mxCell>
<mxCell id="c75" value="&lt;b&gt;6. TRAIN, SELECT AND EVALUATE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Aptos;fontSize=14;fontColor=#188489;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="394.6" y="526.1" width="487.7" height="22.1" as="geometry"/></mxCell>
<mxCell id="c76" value="Train both models with BCEWithLogitsLoss and Adam (learning rate 0.001; batch size 8). Use validation performance to select the best checkpoint. At test time, apply sigmoid to model logits, threshold probabilities at 0.5 to obtain a binary mask, then compare predictions with ground-truth masks using Dice, IoU, precision and recall." style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Aptos;fontSize=11;fontColor=#26313D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="394.6" y="553.0" width="487.7" height="79.7" as="geometry"/></mxCell>
<mxCell id="c77" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E7F4EF;strokeColor=#BECDDA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="908.2" y="112.3" width="347.5" height="83.5" as="geometry"/></mxCell>
<mxCell id="c78" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#188489;strokeColor=#188489;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="908.2" y="112.3" width="6.2" height="83.5" as="geometry"/></mxCell>
<mxCell id="c79" value="&lt;b&gt;TEST-SET RESULTS&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Aptos;fontSize=14;fontColor=#188489;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920.6" y="118.1" width="326.4" height="22.1" as="geometry"/></mxCell>
<mxCell id="c80" value="26 held-out images  |  pixel threshold = 0.5&lt;br&gt;Same test split and evaluation procedure for both models." style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Aptos;fontSize=11;fontColor=#26313D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="920.6" y="145.0" width="326.4" height="46.1" as="geometry"/></mxCell>
