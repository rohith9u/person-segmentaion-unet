<mxCell id="c10" value="&lt;b&gt;ABSTRACT&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Aptos;fontSize=14;fontColor=#2A69A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="36.5" y="118.1" width="319.7" height="22.1" as="geometry"/></mxCell>
<mxCell id="c11" value="We built a pixel-wise person segmentation system using U-Net. Each input image is converted into a binary mask that labels person pixels as 1 and background pixels as 0. We trained and compared two versions: a baseline model and the same model trained with data augmentation." style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Aptos;fontSize=12;fontColor=#26313D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="36.5" y="145.0" width="319.7" height="74.9" as="geometry"/></mxCell>
<mxCell id="c12" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BECDDA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="24.0" y="235.2" width="340.8" height="112.3" as="geometry"/></mxCell>
<mxCell id="c13" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#188489;strokeColor=#188489;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="24.0" y="235.2" width="6.2" height="112.3" as="geometry"/></mxCell>
<mxCell id="c14" value="&lt;b&gt;PROBLEM &amp;amp; OBJECTIVE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Aptos;fontSize=14;fontColor=#188489;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="36.5" y="241.0" width="319.7" height="22.1" as="geometry"/></mxCell>
<mxCell id="c15" value="Task: identify every person at pixel level, including scenes with multiple people.&lt;br&gt;Objective: test whether horizontal flipping and small zoom transformations improve segmentation on unseen test images." style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Aptos;fontSize=12;fontColor=#26313D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="36.5" y="267.8" width="319.7" height="74.9" as="geometry"/></mxCell>
<mxCell id="c16" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EBF3FA;strokeColor=#BECDDA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="24.0" y="358.1" width="340.8" height="129.6" as="geometry"/></mxCell>
<mxCell id="c17" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2A69A6;strokeColor=#2A69A6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="24.0" y="358.1" width="6.2" height="129.6" as="geometry"/></mxCell>
<mxCell id="c18" value="&lt;b&gt;DATASET &amp;amp; PREPARATION&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Aptos;fontSize=14;fontColor=#2A69A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="36.5" y="363.8" width="319.7" height="22.1" as="geometry"/></mxCell>
<mxCell id="c19" value="Penn–Fudan Pedestrian Dataset&lt;br&gt;• 170 images containing 345 person instances&lt;br&gt;• Combine all instance masks in an image into one binary person mask&lt;br&gt;• Resize image and mask to 256 × 256 pixels&lt;br&gt;• Split: 119 training, 25 validation, 26 test images" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Aptos;fontSize=12;fontColor=#26313D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="36.5" y="390.7" width="319.7" height="92.2" as="geometry"/></mxCell>
<mxCell id="c20" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E7F4EF;strokeColor=#BECDDA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="24.0" y="498.2" width="340.8" height="139.2" as="geometry"/></mxCell>
<mxCell id="c21" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#188489;strokeColor=#188489;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="24.0" y="498.2" width="6.2" height="139.2" as="geometry"/></mxCell>
<mxCell id="c22" value="&lt;b&gt;EXPERIMENTAL DESIGN&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Aptos;fontSize=14;fontColor=#188489;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="36.5" y="504.0" width="319.7" height="22.1" as="geometry"/></mxCell>
<mxCell id="c23" value="Baseline: train U-Net without augmentation.&lt;br&gt;&lt;br&gt;Augmented: train the same U-Net with random horizontal flip (p = 0.5) and zoom (0.9–1.1). Apply each geometric transform to both image and mask so their pixels remain aligned." style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Aptos;fontSize=12;fontColor=#26313D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="36.5" y="530.9" width="319.7" height="101.8" as="geometry"/></mxCell>
<mxCell id="c24" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EBF3FA;strokeColor=#BECDDA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="382.1" y="112.3" width="508.8" height="87.4" as="geometry"/></mxCell>
<mxCell id="c25" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2A69A6;strokeColor=#2A69A6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="382.1" y="112.3" width="6.2" height="87.4" as="geometry"/></mxCell>
<mxCell id="c26" value="&lt;b&gt;METHODOLOGY: END-TO-END WORKFLOW&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Aptos;fontSize=14;fontColor=#2A69A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="394.6" y="118.1" width="487.7" height="22.1" as="geometry"/></mxCell>
<mxCell id="c27" value="The same preprocessing, U-Net architecture, loss function and evaluation protocol are used for both experiments; only the training augmentation differs." style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontFamily=Aptos;fontSize=12;fontColor=#26313D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="394.6" y="145.0" width="487.7" height="49.9" as="geometry"/></mxCell>
